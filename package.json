{
  "name": "linkmystic",
  "productName": "LinkMystic",
  "version": "0.1.0",
  "description": "Lightweight open-source RGB sync and fan control for MSI Mystic Light motherboards and Corsair iCUE LINK: synced lighting, AIO pump and fan curves, and animated pump LCD themes.",
  "license": "GPL-3.0-or-later",
  "author": "LinkMystic contributors",
  "homepage": "https://github.com/woo-jobradovic/linkmystic",
  "repository": {
    "type": "git",
    "url": "https://github.com/woo-jobradovic/linkmystic.git"
  },
  "private": true,
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test \"test/*.test.js\"",
    "lint": "eslint .",
    "diagnostics": "node src/engine/diagnostics.js",
    "dist": "electron-builder --win nsis --publish never",
    "themes:preview": "electron scripts/theme-sheet.cjs theme-sheet.png"
  },
  "dependencies": {
    "node-hid": "3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "eslint": "10.13.0",
    "globals": "17.13.0"
  },
  "build": {
    "appId": "io.github.linkmystic",
    "productName": "LinkMystic",
    "copyright": "Copyright (C) 2026 LinkMystic contributors. GPL-3.0-or-later.",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "!assets/icon-png/icon-16.png",
      "!**/node_modules/node-hid/hidapi/**",
      "!**/node_modules/node-hid/src/**",
      "!**/node_modules/node-hid/prebuilds/HID-darwin-*/**",
      "!**/node_modules/node-hid/prebuilds/HID-linux-*/**",
      "!**/node_modules/node-hid/prebuilds/HID_hidraw-*/**",
      "!**/node_modules/node-hid/prebuilds/HID-win32-ia32/**",
      "!**/node_modules/node-hid/prebuilds/HID-win32-arm64/**",
      "!**/node_modules/node-addon-api/**"
    ],
    "asarUnpack": [
      "**/node_modules/node-hid/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "LinkMystic-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LinkMystic",
      "license": "LICENSE",
      "deleteAppDataOnUninstall": false
    },
    "npmRebuild": false,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "keywords": [
    "rgb",
    "rgb-sync",
    "msi",
    "mystic-light",
    "msi-mystic-light",
    "corsair",
    "icue",
    "icue-link",
    "icue-alternative",
    "argb",
    "fan-control",
    "aio",
    "pump-lcd",
    "lcd-themes",
    "windows",
    "gaming"
  ],
  "bugs": {
    "url": "https://github.com/woo-jobradovic/linkmystic/issues"
  }
}
